# --- Backend FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# --- Banco de Dados SQLite / PostgreSQL ---
DATABASE_URL=sqlite:///./data/vulcantech.db

# --- Frontend Streamlit ---
STREAMLIT_PORT=8501

# --- Diretório de Runtime e Histórico do Simulador ---
VULCANTECH_RUNTIME_DIR=.
